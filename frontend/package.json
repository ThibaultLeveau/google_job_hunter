{
  "name": "job-hunter-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "scripts": {
    "dev": "npm run generate:api && vite",
    "typecheck": "npm run generate:api && tsc --noEmit",
    "lint": "npm run generate:api && eslint . --max-warnings 0",
    "test": "npm run generate:api && vitest run",
    "test:coverage": "npm run generate:api && vitest run --coverage",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "generate:api": "node generate-api.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.106.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "overrides": {
    "minimatch@10.2.6": "11.0.1",
    "openapi-typescript": {
      "undici": "6.29.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "msw": "3.0.3",
    "openapi-typescript": "6.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  }
}
