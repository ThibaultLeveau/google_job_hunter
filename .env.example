# Copy to .env.runtime (mode 0600). Replace every placeholder before starting.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
JOB_HUNTER_DATABASE_URL=postgresql+psycopg://job_hunter:replace-with-the-same-password@database:5432/job_hunter
JOB_HUNTER_TRUSTED_HOSTS='["app.example.org","localhost","127.0.0.1"]'
JOB_HUNTER_ALLOWED_ORIGINS='["https://app.example.org"]'
JOB_HUNTER_MAIL_PUBLIC_URL=https://app.example.org
JOB_HUNTER_MAIL_SENDER=accounts@example.org
JOB_HUNTER_MAIL_KEY=replace-with-a-Fernet-key
JOB_HUNTER_MAIL_SMTP_HOST=smtp.example.org
JOB_HUNTER_MAIL_SMTP_PORT=465
JOB_HUNTER_MAIL_SMTP_USERNAME=replace-with-smtp-username
JOB_HUNTER_MAIL_SMTP_PASSWORD=replace-with-smtp-password
# Disabled providers allow startup without paid calls; configure deliberately.
JOB_HUNTER_AI_PROVIDER=disabled
JOB_HUNTER_SEARCH_PROVIDER=disabled
# JOB_HUNTER_AI_API_KEY=replace-with-provider-credential
# JOB_HUNTER_AI_CHAT_MODEL=replace-with-model-id
# JOB_HUNTER_AI_EMBEDDING_MODEL=replace-with-model-id
# JOB_HUNTER_SEARCH_API_KEY=replace-with-provider-credential
# Google settings are optional; configure all three together.
# JOB_HUNTER_GOOGLE_CLIENT_ID=replace-with-client-id
# JOB_HUNTER_GOOGLE_CLIENT_SECRET=replace-with-client-secret
# JOB_HUNTER_GOOGLE_REDIRECT_URI=https://app.example.org/api/auth/google/callback
